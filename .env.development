# Local-only defaults. Do not reuse these credentials in shared or production environments.
FASHION_NETWORK_ENVIRONMENT=development
FASHION_NETWORK_LOG_LEVEL=INFO
FASHION_NETWORK_API_HOST=0.0.0.0
FASHION_NETWORK_API_PORT=8000
TZ=UTC
NEXT_PUBLIC_API_BASE_URL=http://api.localhost

POSTGRES_DB=fashion_network
POSTGRES_USER=fashion_network
POSTGRES_PASSWORD=fashion_network_dev_postgres
FASHION_NETWORK_DATABASE_URL=postgresql+asyncpg://fashion_network:fashion_network_dev_postgres@postgres:5432/fashion_network
FASHION_NETWORK_DATABASE_ECHO=false
FASHION_NETWORK_DATABASE_POOL_SIZE=5
FASHION_NETWORK_DATABASE_MAX_OVERFLOW=10
FASHION_NETWORK_DATABASE_POOL_TIMEOUT_SECONDS=30
FASHION_NETWORK_DATABASE_POOL_RECYCLE_SECONDS=1800
FASHION_NETWORK_DATABASE_COMMAND_TIMEOUT_SECONDS=30

REDIS_PASSWORD=fashion_network_dev_redis
FASHION_NETWORK_REDIS_URL=redis://:fashion_network_dev_redis@redis:6379/0

RABBITMQ_USER=fashion_network
RABBITMQ_PASSWORD=fashion_network_dev_rabbitmq
RABBITMQ_VHOST=fashion_network
RABBITMQ_DEFAULT_USER=fashion_network
RABBITMQ_DEFAULT_PASS=fashion_network_dev_rabbitmq
RABBITMQ_DEFAULT_VHOST=fashion_network
FASHION_NETWORK_RABBITMQ_URL=amqp://fashion_network:fashion_network_dev_rabbitmq@rabbitmq:5672/fashion_network

MEILI_MASTER_KEY=fashion_network_dev_meilisearch_key
MEILI_ENV=development
MEILI_NO_ANALYTICS=true
FASHION_NETWORK_MEILISEARCH_URL=http://meilisearch:7700

MINIO_ROOT_USER=fashion_network
MINIO_ROOT_PASSWORD=fashion_network_dev_minio_secret
MINIO_BUCKET=fashion-network-media
FASHION_NETWORK_S3_ENDPOINT_URL=http://minio:9000
FASHION_NETWORK_S3_REGION=auto
FASHION_NETWORK_S3_ACCESS_KEY_ID=fashion_network
FASHION_NETWORK_S3_SECRET_ACCESS_KEY=fashion_network_dev_minio_secret
FASHION_NETWORK_S3_BUCKET=fashion-network-media

FLOWER_USER=fashion_network
FLOWER_PASSWORD=fashion_network_dev_flower
FLOWER_BASIC_AUTH=fashion_network:fashion_network_dev_flower

FASHION_NETWORK_SMTP_HOST=mailpit
FASHION_NETWORK_SMTP_PORT=1025
MP_DATABASE=/data/mailpit.db
MP_MAX_MESSAGES=500

NEXT_TELEMETRY_DISABLED=1
WATCHPACK_POLLING=true
