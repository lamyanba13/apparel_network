# Application
FASHION_NETWORK_ENVIRONMENT=development
FASHION_NETWORK_LOG_LEVEL=INFO
FASHION_NETWORK_API_HOST=127.0.0.1
FASHION_NETWORK_API_PORT=8000

# Browser-safe configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Future service connections (not used by Phase 1.1)
FASHION_NETWORK_DATABASE_URL=postgresql+psycopg://fashion_network:fashion_network@localhost:5432/fashion_network
FASHION_NETWORK_REDIS_URL=redis://localhost:6379/0
FASHION_NETWORK_RABBITMQ_URL=amqp://fashion_network:fashion_network@localhost:5672//
FASHION_NETWORK_MEILISEARCH_URL=http://localhost:7700
FASHION_NETWORK_S3_ENDPOINT_URL=http://localhost:9000

