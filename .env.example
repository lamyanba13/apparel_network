# Fashion Network environment template
# Copy this file to .env.development for local Docker Compose usage.
# Values ending in _dev_* are local-only defaults and must never be reused outside development.

# Application runtime
FASHION_NETWORK_APPLICATION_NAME=Fashion Network API
FASHION_NETWORK_APPLICATION_VERSION=0.1.0
FASHION_NETWORK_APPLICATION_DESCRIPTION=Shared API foundation for the Fashion Network inventory network.
FASHION_NETWORK_APPLICATION_CONTACT_NAME=Fashion Network Engineering
FASHION_NETWORK_APPLICATION_LICENSE_NAME=Proprietary
FASHION_NETWORK_ENVIRONMENT=development
FASHION_NETWORK_LOG_LEVEL=INFO
FASHION_NETWORK_API_HOST=0.0.0.0
FASHION_NETWORK_API_PORT=8000
FASHION_NETWORK_API_SERVER_URLS=["http://localhost:8000"]
FASHION_NETWORK_TRUSTED_HOSTS=["localhost","127.0.0.1","testserver","api.localhost","backend"]
FASHION_NETWORK_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
FASHION_NETWORK_CORS_ALLOW_CREDENTIALS=true
FASHION_NETWORK_GZIP_MINIMUM_SIZE=1000
FASHION_NETWORK_BROTLI_ENABLED=true
FASHION_NETWORK_BROTLI_QUALITY=4
FASHION_NETWORK_ETAG_ENABLED=false
FASHION_NETWORK_RATE_LIMIT_ENABLED=false
FASHION_NETWORK_METRICS_ENABLED=true
FASHION_NETWORK_METRICS_PATH=/metrics
FASHION_NETWORK_HEALTH_CHECK_TIMEOUT_SECONDS=3
FASHION_NETWORK_SLOW_REQUEST_THRESHOLD_MS=1000
FASHION_NETWORK_SLOW_QUERY_THRESHOLD_MS=500
FASHION_NETWORK_OPENTELEMETRY_ENABLED=false
FASHION_NETWORK_OPENTELEMETRY_SERVICE_NAME=fashion-network-api
FASHION_NETWORK_OPENTELEMETRY_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
FASHION_NETWORK_OPENTELEMETRY_TRACE_SAMPLE_RATIO=0.1
FASHION_NETWORK_SENTRY_ENABLED=false
FASHION_NETWORK_SENTRY_DSN=
FASHION_NETWORK_SENTRY_TRACE_SAMPLE_RATE=0
FASHION_NETWORK_AUTH_ACCESS_TOKEN_LIFETIME_SECONDS=900
FASHION_NETWORK_AUTH_REFRESH_TOKEN_LIFETIME_DAYS=30
FASHION_NETWORK_SESSION_ACTIVITY_THROTTLE_SECONDS=300
FASHION_NETWORK_SESSION_CLEANUP_RETENTION_DAYS=30
FASHION_NETWORK_SESSION_CLEANUP_BATCH_SIZE=500
FASHION_NETWORK_AUTHORIZATION_CACHE_TTL_SECONDS=60
FASHION_NETWORK_AUTH_REQUIRE_VERIFIED_EMAIL=true
FASHION_NETWORK_PASSWORD_MIN_LENGTH=12
FASHION_NETWORK_PASSWORD_MAX_LENGTH=128
FASHION_NETWORK_PASSWORD_REQUIRE_UPPERCASE=true
FASHION_NETWORK_PASSWORD_REQUIRE_LOWERCASE=true
FASHION_NETWORK_PASSWORD_REQUIRE_NUMBER=true
FASHION_NETWORK_PASSWORD_REQUIRE_SYMBOL=true
FASHION_NETWORK_PASSWORD_FORBIDDEN_VALUES=["password","password123","qwerty123","letmein","fashionnetwork"]
FASHION_NETWORK_PASSWORD_HISTORY_DEPTH=5
FASHION_NETWORK_PASSWORD_RESET_TOKEN_LIFETIME_MINUTES=30
FASHION_NETWORK_EMAIL_VERIFICATION_TOKEN_LIFETIME_HOURS=24
FASHION_NETWORK_ACCOUNT_LOCKOUT_DELAY_THRESHOLD=5
FASHION_NETWORK_ACCOUNT_LOCKOUT_SHORT_THRESHOLD=10
FASHION_NETWORK_ACCOUNT_LOCKOUT_DELAY_SECONDS=30
FASHION_NETWORK_ACCOUNT_LOCKOUT_SHORT_SECONDS=900
FASHION_NETWORK_ACCOUNT_LOCKOUT_WINDOW_SECONDS=900
FASHION_NETWORK_ACCOUNT_LOCKOUT_MAX_SECONDS=14400
FASHION_NETWORK_ACCOUNT_SECURITY_CLEANUP_BATCH_SIZE=500
FASHION_NETWORK_AUTH_LOGIN_RATE_LIMIT=5
FASHION_NETWORK_AUTH_REFRESH_RATE_LIMIT=20
FASHION_NETWORK_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
FASHION_NETWORK_PUBLIC_RATE_LIMIT=120
FASHION_NETWORK_STORE_RATE_LIMIT=120
FASHION_NETWORK_ADMIN_RATE_LIMIT=60
FASHION_NETWORK_JWT_ALGORITHM=EdDSA
FASHION_NETWORK_JWT_ISSUER=fashion-network
FASHION_NETWORK_JWT_AUDIENCE=fashion-network-api
FASHION_NETWORK_JWT_CURRENT_KEY_ID=primary
# Inject an unencrypted PKCS#8 private PEM through the environment/secret manager.
FASHION_NETWORK_JWT_PRIVATE_KEY_PEM=
# JSON object mapping retired kid values to public PEM strings.
FASHION_NETWORK_JWT_PREVIOUS_PUBLIC_KEYS={}
FASHION_NETWORK_JWT_CLOCK_SKEW_SECONDS=30
FASHION_NETWORK_APPLICATION_CONTACT_URL=https://example.invalid/contact
FASHION_NETWORK_APPLICATION_LICENSE_URL=https://example.invalid/license
TZ=UTC

# Browser-visible API origin routed by the local Nginx gateway
NEXT_PUBLIC_API_BASE_URL=http://api.localhost

# PostgreSQL: authoritative database and async SQLAlchemy pool
POSTGRES_DB=fashion_network
POSTGRES_USER=fashion_network
POSTGRES_PASSWORD=fashion_network_dev_postgres
FASHION_NETWORK_DATABASE_URL=postgresql+asyncpg://fashion_network:fashion_network_dev_postgres@postgres:5432/fashion_network
FASHION_NETWORK_DATABASE_ECHO=false
FASHION_NETWORK_DATABASE_POOL_SIZE=5
FASHION_NETWORK_DATABASE_MAX_OVERFLOW=10
FASHION_NETWORK_DATABASE_POOL_TIMEOUT_SECONDS=30
FASHION_NETWORK_DATABASE_POOL_RECYCLE_SECONDS=1800
FASHION_NETWORK_DATABASE_COMMAND_TIMEOUT_SECONDS=30

# Redis: cache, sessions, rate limiting, temporary locks, and ephemeral coordination only
REDIS_PASSWORD=fashion_network_dev_redis
FASHION_NETWORK_REDIS_URL=redis://:fashion_network_dev_redis@redis:6379/0

# RabbitMQ: the only Celery broker
RABBITMQ_USER=fashion_network
RABBITMQ_PASSWORD=fashion_network_dev_rabbitmq
RABBITMQ_VHOST=fashion_network
RABBITMQ_DEFAULT_USER=fashion_network
RABBITMQ_DEFAULT_PASS=fashion_network_dev_rabbitmq
RABBITMQ_DEFAULT_VHOST=fashion_network
FASHION_NETWORK_RABBITMQ_URL=amqp://fashion_network:fashion_network_dev_rabbitmq@rabbitmq:5672/fashion_network

# Meilisearch: rebuildable local search projection
MEILI_MASTER_KEY=fashion_network_dev_meilisearch_key
MEILI_ENV=development
MEILI_NO_ANALYTICS=true
FASHION_NETWORK_MEILISEARCH_URL=http://meilisearch:7700

# MinIO: local S3-compatible substitute for Cloudflare R2
MINIO_ROOT_USER=fashion_network
MINIO_ROOT_PASSWORD=fashion_network_dev_minio_secret
MINIO_BUCKET=fashion-network-media
FASHION_NETWORK_S3_ENDPOINT_URL=http://minio:9000
FASHION_NETWORK_S3_REGION=auto
FASHION_NETWORK_S3_ACCESS_KEY_ID=fashion_network
FASHION_NETWORK_S3_SECRET_ACCESS_KEY=fashion_network_dev_minio_secret
FASHION_NETWORK_S3_BUCKET=fashion-network-media

# Flower: local Celery monitoring UI basic authentication
FLOWER_USER=fashion_network
FLOWER_PASSWORD=fashion_network_dev_flower
FLOWER_BASIC_AUTH=fashion_network:fashion_network_dev_flower

# Mailpit: local email capture service
FASHION_NETWORK_SMTP_HOST=mailpit
FASHION_NETWORK_SMTP_PORT=1025
MP_DATABASE=/data/mailpit.db
MP_MAX_MESSAGES=500

# Containerized web development
NEXT_TELEMETRY_DISABLED=1
WATCHPACK_POLLING=true
