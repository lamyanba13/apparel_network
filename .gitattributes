# Normalize text files to LF in the repository.
* text=auto eol=lf

# Windows command scripts require CRLF for native compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicitly preserve executable and configuration files as LF text.
*.sh text eol=lf
*.ps1 text eol=lf
Makefile text eol=lf
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.lock text eol=lf

# Binary assets must never undergo line-ending conversion.
*.avif -text
*.bmp -text
*.eot -text
*.gif -text
*.ico -text
*.jpeg -text
*.jpg -text
*.otf -text
*.pdf -text
*.png -text
*.ttf -text
*.webp -text
*.woff -text
*.woff2 -text
*.7z -text
*.gz -text
*.jar -text
*.tar -text
*.zip -text
