# Production configuration contract.
# Supply every secret through the selected secret manager; never commit real values here.
FASHION_NETWORK_ENVIRONMENT=production
FASHION_NETWORK_LOG_LEVEL=INFO
FASHION_NETWORK_API_HOST=0.0.0.0
FASHION_NETWORK_API_PORT=8000
FASHION_NETWORK_API_SERVER_URLS=["https://api.example.invalid"]
